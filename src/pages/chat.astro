---
import Layout from '../layouts/Layout.astro';
import App from '../components/App.svelte';
---

<Layout
  title="Subir y Chatear con tu PDF — ChatPDF"
  description="Subí tu documento PDF y comenzá a hacer preguntas directamente a la inteligencia artificial. Sin registros ni esperas."
>
  <div class="min-h-screen w-full flex flex-col justify-between">
    <header class="w-full max-w-4xl mx-auto pt-6 px-4 sm:px-6 flex justify-between items-center">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors py-1.5 px-3 rounded-lg hover:bg-slate-100/80 border border-slate-200/60 bg-white/50 backdrop-blur-sm shadow-sm"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>Inicio</span>
      </a>
      <span class="text-xs font-semibold tracking-wider uppercase text-slate-400">ChatPDF</span>
    </header>

    <main class="flex-1 flex flex-col justify-center items-center px-4 py-8 w-full max-w-2xl mx-auto">
      <h1 class="text-3xl md:text-5xl opacity-80 font-bold text-center mb-6 tracking-tight text-slate-900">
        Chat with your PDF
      </h1>
      <section class="w-full">
        <App client:load />
      </section>
    </main>

    <footer class="py-4 text-center text-xs text-slate-400">
      Directo y privado · Sin registro previo
    </footer>
  </div>
</Layout>
